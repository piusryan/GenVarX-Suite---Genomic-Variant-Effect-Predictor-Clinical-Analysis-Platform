# Auto detect text files and perform LF normalization
* text=auto

# Git LFS tracking for large dataset files
data/datasets/**/*.gz filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.zip filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.vcf filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.tsv filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.csv filter=lfs diff=lfs merge=lfs -text
data/datasets/clinvar/disease_names filter=lfs diff=lfs merge=lfs -text
